/*@meta

Author:
'Sound Dust'

Description:
'Very confused robot arps'

Usage:
'MW more confusion\r\nPlay with ENV1 for more shapes'

Categories:
'Keys:Classic, Keys:Piano, Sequences & Arps:Evolving, Sequences & Arps:Melodic, Sequences & Arps:Plucked'

Features:
'Poly, Sequenced, Host Synced, Effects, Sustained'

Character:
'Bright, Soft, Inharmonic, Distorted, Vintage, Electric'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
#ms=Xpress
#ms=Gate
#ms=Velocity
#ms=Pressure
