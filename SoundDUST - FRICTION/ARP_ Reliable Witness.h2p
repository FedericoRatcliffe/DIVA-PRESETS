PWM1=1				// Pwm1On
Tri2=0				// Triangle2On
Saw2=1				// Saw2On
PW2=0				// Pulse2On
PWM2=1				// PWM2On
Noise1=0				// Noise1On
triSp=2				// ShapeModel=analog2
