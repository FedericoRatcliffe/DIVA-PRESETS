Sus=53.00			// Sustain
Rel=0.00			// Release
Vel=0.00			// Velocity
Model=2				// Model=digital
Trig=0				// Trigger=Gate
Quant=0				// Quantise
Crve=0				// Curve
RelOn=1				// Release On=VCF
KeyFlw=0.00			// KeyFollow

