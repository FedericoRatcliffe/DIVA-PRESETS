Dec=40.00			// Decay
Sus=0.00			// Sustain
Rel=0.00			// Release
Vel=45.00			// Velocity
Model=1				// Model=analogue
Trig=0				// Trigger=Gate
Quant=0				// Quantise
Crve=0				// Curve
RelOn=0				// Release On=VCA
