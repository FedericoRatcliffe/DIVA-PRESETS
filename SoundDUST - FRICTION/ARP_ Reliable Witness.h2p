/*@meta

Author:
'Sound Dust'

Usage:
'MW & AT finger on the tape loop'

Categories:
'Sequences & Arps:Melodic'

Features:
'Poly, Arpeggiated, Sequenced, Host Synced, Percussive'

Character:
'Dark, Evolving, Wide, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
#ms=Xpress
#ms=Gate
#ms=Velocity
#ms=Pressure
#ms=KeyFollow
#ms=KeyFollow2
#ms=Alternate
#ms=Random
#ms=StackVoice
#ms=VoiceMap
#ms=Env1
#ms=Env2
#ms=LFO1
#ms=LFO2
#ms=Rectify
#ms=Invert
#ms=Quant
#ms=Lag
#ms=Adder
#ms=Multiply
#nv=2
#mv=Gate
#mv=Env1

/*

	Main Loop Circuit

*/

#cm=main
CcOp=100.00			// Output
#FX1=1				// Active #FX1
#FX2=1				// Active #FX2

/*

	Core

*/

#cm=PCore
SBase=4				// SwingBase=1/4
Swing=0.00			// Swing
STrig=1				// SwingTrigger
PSong=0				// PatchSong
PFold=0				// binary data for PatchFolder
PFile=1				// binary data for PatchFileName
Rev=4078				// Revision
LED=0.75			// LED Colour
MidiA=2				// binary data for Midi A param
MidiP=3				// binary data for Midi P param

/*

	ARP Clock

*/

#cm=CLK
Mult=100.00			// Multiply
Base=1				// TimeBase=1/16
Swing=6.50			// Swing
Strict=1				// Strict Host Sync

/*

	Arpeggiator

*/

#cm=ARP
Dir=2				// Direction=down
Oct=3				// Octaves
CDiv=0				// Multiply=1x
Rstrt=4				// Restart=7
OnOff=1				// OnOff
Order=0				// Order=serial

/*

	VoiceCircuit

*/

#cm=VCC
Voices=5				// Voices=8
Voicing=2				// Voice Stack
Mode=0				// Mode=poly
PortaM=0				// GlideMode=time
Porta=0.00			// Glide
Porta2=0.00			// Glide2
PRange=100.00			// GlideRange
PB=12				// PitchBend Up
PBD=12				// PitchBend Down
Drft=0				// Drift
MTunS=0				// TuningMode
MTunN=4				// binary data for Tuning
MTunT=5				// binary data for TuningTable
Trsp=0				// Transpose
FTun=0.00			// FineTuneCents
Vc1=0.00			// Voice1
Vc2=12.00			// Voice2
Vc3=-12.00			// Voice3
Vc4=12.00			// Voice4
Vc5=0.00			// Voice5
Vc6=0.00			// Voice6
Vc7=0.00			// Voice7
Vc8=0.00			// Voice8
Prior=0				// Note Priority=last
ContEn=1				// ContinuousEnv
rMW=0.00			// Internal ModWheel
rPW=0.00			// Internal PitchWheel

/*

	GlobalSettings

*/

#cm=OPT
V1T1=-8.00			// V1Tune1
V2T1=-16.00			// V2Tune1
V3T1=20.00			// V3Tune1
V4T1=0.00			// V4Tune1
