/*@meta

Author:
'Sound Dust'

Description:
'Try different filter types'

Usage:
'MW scratch for more bentness\r\nAt scratchy'

Categories:
'Drums:Clicks & Snips, Drums:Percussion'

Features:
'Poly, Sequenced, Host Synced, Effects, Percussive, CrossMod'

Character:
'Bright, Evolving, Soft, Vintage, Electric'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
