/*@meta

Author:
'Sound Dust'

Description:
'From station to station\r\nBack to Dusseldorf City\r\nMeet Iggy Pop and David Bowie'

Usage:
'Fine tune CUTOFF,  ENV1 decay and ENV2 Attack'

Categories:
'Sequences & Arps:Drum Loops, Sequences & Arps:Effects'

Features:
'Poly, Arpeggiated, Sequenced, Host Synced'

Character:
'Evolving, Inharmonic, Defined & Sparse, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
#ms=Xpress
#ms=Gate
#ms=Velocity
#ms=Pressure
#ms=KeyFollow
#ms=KeyFollow2
#ms=Alternate
#ms=Random
#ms=StackVoice
#ms=VoiceMap
#ms=Env1
#ms=Env2
#ms=LFO1
#ms=LFO2
#ms=Rectify
#ms=Invert
#ms=Quant
#ms=Lag
#ms=Adder
#ms=Multiply
#nv=2
#mv=Gate
#mv=Env1

/*

	Main Loop Circuit

*/

#cm=main
CcOp=98.00			// Output
#FX1=1				// Active #FX1
#FX2=1				// Active #FX2

/*

	Core

*/

#cm=PCore
SBase=4				// SwingBase=1/4
Swing=0.00			// Swing
STrig=1				// SwingTrigger
PSong=0				// PatchSong
PFold=0				// binary data for PatchFolder
