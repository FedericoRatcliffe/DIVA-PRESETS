MidiP=3				// binary data for Midi P param

/*

	ARP Clock

*/

#cm=CLK
Mult=100.00			// Multiply
Base=1				// TimeBase=1/16
Swing=8.00			// Swing
Strict=1				// Strict Host Sync

/*

	Arpeggiator

*/

#cm=ARP
Dir=4				// Direction=up+dn 2
Oct=3				// Octaves
CDiv=0				// Multiply=1x
Rstrt=1				// Restart=4
OnOff=1				// OnOff
Order=0				// Order=serial

/*

	VoiceCircuit

*/

