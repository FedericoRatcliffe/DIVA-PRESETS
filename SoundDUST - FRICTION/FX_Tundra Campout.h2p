/*@meta

Author:
'Sound Dust'

Description:
'Who\'d pitch a tent out here.'

Usage:
'MW wind chill\r\nAT wind speed'

Categories:
'FX:Glitch & Weird, FX:Nature & Ambient, FX:Noise & Rumble'

Features:
'Poly, Percussive'

Character:
'Aggressive, Inharmonic, Defined & Sparse, Distorted'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
