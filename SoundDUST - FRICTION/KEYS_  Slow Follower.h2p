/*@meta

Author:
'Sound Dust'

Description:
'It always gets there in the end\r\nENV 2 decay for fine tuning/un-tuning'

Usage:
'MW filter\r\nAT bend'

Categories:
'Keys:Evolving, Keys:Distorted, Keys:Organs, Keys:Piano'

