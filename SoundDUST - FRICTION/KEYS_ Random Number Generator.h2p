/*@meta

Author:
'Sound Dust'

Description:
'You\'ll see'

Usage:
'MW smaller\r\nAt bendy'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
