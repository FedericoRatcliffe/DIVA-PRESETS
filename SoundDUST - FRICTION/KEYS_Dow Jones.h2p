/*@meta

Author:
'Sound Dust'

Description:
'Organish, electric piano hybrid'

Usage:
'MW adds brightness'

Categories:
'Keys:Classic, Keys:Organs'

Features:
'Poly'

Character:
'Bright, Soft, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
#ms=Xpress
#ms=Gate
#ms=Velocity
#ms=Pressure
#ms=KeyFollow
