/*@meta

Author:
'Sound Dust'

Description:
'Vaguely human sounding'

Usage:
'MW for more chat\r\nAT Bendy'

Categories:
'Keys:Distorted, Keys:Organs'

Features:
'Poly, Soft Attack, Sustained, Modulated, Unison'

Character:
'Dark, Dynamic, Evolving, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10201
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
