/*@meta

Author:
'Sound Dust'

Usage:
'MW filter\r\nAT thickness'

Categories:
'Leads:Distorted, Leads:Sync Lead, Leads:Synth'

Features:
'Poly, Effects, Percussive, Sustained'

Character:
'Static, Evolving, Aggressive, Wide, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
