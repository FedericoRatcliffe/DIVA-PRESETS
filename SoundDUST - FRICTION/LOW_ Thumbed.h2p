/*@meta

Author:
'Sound Dust'

Description:
'Round and mellow'

Usage:
'MW movement\r\nAT bend'

Categories:
'Basses:Acoustic, Basses:Analogue, Basses:Plucked, Basses:Sub'

Features:
'Mono, Dry, Percussive'

Character:
'Dark, Dynamic, Defined & Sparse, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
