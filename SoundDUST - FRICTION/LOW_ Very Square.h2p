/*@meta

Author:
'Sound Dust'

Usage:
'MW use to play the filter'

Categories:
'Basses:Analogue, Basses:Distorted'

Features:
'Mono, Soft Attack, Sustained, Osc Sync'

Character:
'Dynamic, Evolving, Harmonic, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

