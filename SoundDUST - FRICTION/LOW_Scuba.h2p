/*@meta

Author:
'Sound Dust'

Usage:
'MW adds spice'

Categories:
'Basses:Analogue, Basses:Digital, Basses:Evolving, Basses:Sub'

Features:
'Mono, Sustained, Unison'

Character:
'Dark, Dynamic, Constant, Inharmonic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
#ms=Xpress
#ms=Gate
#ms=Velocity
#ms=Pressure
