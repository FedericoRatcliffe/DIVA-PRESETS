/*

	Arpeggiator

*/

#cm=ARP
Dir=1				// Direction=up
Oct=2				// Octaves
CDiv=0				// Multiply=1x
Rstrt=0				// Restart=none
OnOff=0				// OnOff
Order=0				// Order=serial

