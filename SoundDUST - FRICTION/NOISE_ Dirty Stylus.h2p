/*@meta

Author:
'Sound Dust'

Usage:
'MW more noise\r\nAT more cliks'

Categories:
'FX:Glitch & Weird, FX:Hits & Impacts, FX:Nature & Ambient, FX:Noise & Rumble'

Features:
'Poly, Host Synced'

Character:
'Dynamic, Evolving, Aggressive, Inharmonic, Defined & Sparse, Distorted, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
