/*@meta

Author:
'Sound Dust'

Description:
'Play with filters  for variations'

Usage:
'MW closes the filter\r\nAT bend'

Categories:
'FX:Glitch & Weird, FX:Hits & Impacts, FX:Noise & Rumble, FX:Rhythmic, Sequences & Arps:Drum Loops, Sequences & Arps:Effects'

Features:
'Mono, Arpeggiated, Host Synced, Percussive, Unison'

Character:
'Static, Inharmonic, Defined & Sparse, Modern, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
#ms=Xpress
#ms=Gate
#ms=Velocity
