/*@meta

Author:
'Sound Dust'

Usage:
'MW wibble wobble\r\nATbend'

Categories:
'Pads:Acoustic, Pads:Drones, Pads:Evolving'

Features:
'Poly, Soft Attack, Slow Release, Modulated'

Character:
'Dynamic, Evolving, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
