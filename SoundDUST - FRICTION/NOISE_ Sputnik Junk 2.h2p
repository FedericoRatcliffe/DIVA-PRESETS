/*@meta

Author:
'Sound Dust'

Usage:
'MW more artifacts\r\nAT Bend'

Categories:
'FX:Beeps & Bloops, FX:Glitch & Weird, FX:Hits & Impacts, FX:Rhythmic'

Features:
'Poly, Host Synced, Effects, Percussive, Sustained, Modulated'

Character:
'Dynamic, Evolving, Inharmonic, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
