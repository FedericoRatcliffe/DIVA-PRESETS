/*@meta

Author:
'Sound Dust'

Description:
'play with modulation sources for variation'

Usage:
'MW wobble\r\nAT chat'

Categories:
'FX:Beeps & Bloops, FX:Glitch & Weird, FX:Noise & Rumble, FX:Vocal'

Features:
'Poly, Effects, Percussive, Sustained'

Character:
'Dark, Evolving, Aggressive, Inharmonic, Defined & Sparse, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
#ms=Xpress
#ms=Gate
#ms=Velocity
#ms=Pressure
