/*@meta

Author:
'Sound Dust'

Description:
'Organ in a blizzard'

Usage:
'MW open the tent flap\r\nAT bend'

Categories:
'Pads, Keys:Classic, Keys:Mallets, Keys:Distorted, Keys:Synthetic, FX:Glitch & Weird, FX:Hits & Impacts, FX:Sweeps & Risers'

Features:
'Poly, Effects, Percussive'

Character:
'Static, Soft, Inharmonic, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
#ms=Xpress
#ms=Gate
#ms=Velocity
#ms=Pressure
#ms=KeyFollow
#ms=KeyFollow2
#ms=Alternate
