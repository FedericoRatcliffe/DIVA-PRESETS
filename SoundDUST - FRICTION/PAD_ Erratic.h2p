/*@meta

Author:
'Sound Dust'

Description:
'irritablel synth, slow and spluttering'

Usage:
'MW hints of brightness\r\nAT bend'

Categories:
'Pads:Drones, Pads:Evolving, Pads:Strings'

Features:
'Poly, Effects, Percussive, Sustained, Modulated, Unison'

Character:
'Bright, Evolving, Soft, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
