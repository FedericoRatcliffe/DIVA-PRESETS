/*@meta

Author:
'Sound Dust'

Usage:
'MW filter mayhem\r\nAT bend'

Categories:
'Pads:Breathy, Pads:Drones, Pads:Evolving, Pads:Soundscape, Pads:Strings'

Features:
'Poly, Soft Attack, Slow Release, Unison'

Character:
'Dynamic, Evolving, Inharmonic, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
