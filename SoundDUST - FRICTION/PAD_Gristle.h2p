/*@meta

Author:
'Sound Dust'

Description:
'Evil string pad'

Usage:
'MW adds bile\r\nAT bend'

Categories:
'Bass:Analogue, Pads:Strings, Pads:Distorted'

Features:
'Poly, Dry, Sustained'

Character:
'Static, Constant, Aggressive, Rich & Phat'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
