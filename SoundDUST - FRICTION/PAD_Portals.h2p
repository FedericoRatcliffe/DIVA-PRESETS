/*@meta

Author:
'Sound Dust'

Usage:
'MW a bit of air\r\nAT Bend'

Categories:
'Pads:Strings'

Features:
'Poly, Effects, Slow Release, Percussive'

Character:
'Dark, Evolving, Soft, Defined & Sparse, Clean, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
