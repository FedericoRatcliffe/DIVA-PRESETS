/*@meta

Author:
'Sound Dust'

Description:
'Play with filter and Env 1 for variations'

Usage:
'MW closes the filter\r\nAT bend'

Categories:
'Drums:Clicks & Snips, Drums:Hats & Crashes'

Features:
'Mono, Dry, Percussive, Unison'

Character:
'Static, Inharmonic, Defined & Sparse, Modern, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

