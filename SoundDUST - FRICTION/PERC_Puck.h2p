/*@meta

Author:
'Sound Dust'

Description:
'Nice low percussion or high snappyness'

Usage:
'MW filter\r\nAT bend'

Categories:
'Drums:Clicks & Snips, Drums:Kicks, Drums:Distorted, Drums:Percussion, Drums:Snares'

Features:
'Poly, Effects, Percussive'

Character:
'Dark, Dynamic, Inharmonic, Defined & Sparse, Distorted'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
