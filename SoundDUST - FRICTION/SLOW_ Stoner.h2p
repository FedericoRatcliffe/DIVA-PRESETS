/*@meta

Author:
'Sound Dust'

Description:
'Take your time, let it slowly seep in.'

Usage:
'MW  extreme modulation\r\nAT bend'

Categories:
'Pads:Distorted, Pads:Drones, Pads:Evolving, FX:Rhythmic'

Features:
'Poly, Host Synced, Effects, Soft Attack, Slow Release'

Character:
'Dark, Dynamic, Evolving, Inharmonic, Defined & Sparse, Vintage, Electric, Synthetic'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
