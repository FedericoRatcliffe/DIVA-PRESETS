/*

	Arpeggiator

*/

#cm=ARP
Dir=1				// Direction=up
Oct=1				// Octaves
CDiv=0				// Multiply=1x
Rstrt=1				// Restart=4
OnOff=0				// OnOff
Order=1				// Order=round

