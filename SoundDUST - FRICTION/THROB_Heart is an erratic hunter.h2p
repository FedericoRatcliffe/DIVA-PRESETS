/*@meta

Author:
'Sound Dust'

Usage:
'experiment with parameter mod for variations\r\n\r\nMW-opens filter\r\nPressure- adds rez'

Categories:
'FX:Beeps & Bloops, FX:Rhythmic, Sequences & Arps:Distorted, Sequences & Arps:Drum Loops'

Features:
'Mono, Sequenced, Host Synced'

Character:
'Dark, Dynamic, Aggressive, Distorted'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
#ms=Xpress
#ms=Gate
#ms=Velocity
#ms=Pressure
#ms=KeyFollow
#ms=KeyFollow2
#ms=Alternate
#ms=Random
#ms=StackVoice
#ms=VoiceMap
#ms=Env1
#ms=Env2
#ms=LFO1
#ms=LFO2
#ms=Rectify
#ms=Invert
#ms=Quant
#ms=Lag
#ms=Adder
#ms=Multiply
#nv=2
#mv=Gate
#mv=Env1

/*

	Main Loop Circuit

*/

#cm=main
CcOp=62.00			// Output
#FX1=0				// Active #FX1
#FX2=1				// Active #FX2

/*

	Core

*/

#cm=PCore
SBase=4				// SwingBase=1/4
Swing=0.00			// Swing
STrig=1				// SwingTrigger
PSong=0				// PatchSong
PFold=0				// binary data for PatchFolder
PFile=1				// binary data for PatchFileName
Rev=4078				// Revision
LED=0.18			// LED Colour
MidiA=2				// binary data for Midi A param
MidiP=3				// binary data for Midi P param

/*

	ARP Clock

*/

#cm=CLK
Mult=100.00			// Multiply
Base=2				// TimeBase=1/8
Swing=0.00			// Swing
Strict=1				// Strict Host Sync

/*

	Arpeggiator

*/

#cm=ARP
Dir=1				// Direction=up
Oct=1				// Octaves
CDiv=0				// Multiply=1x
Rstrt=1				// Restart=4
OnOff=0				// OnOff
Order=1				// Order=round

/*

	VoiceCircuit

*/

#cm=VCC
Voices=4				// Voices=6
Voicing=2				// Voice Stack
Mode=3				// Mode=duo
PortaM=0				// GlideMode=time
Porta=8.00			// Glide
Porta2=0.00			// Glide2
PRange=100.00			// GlideRange
PB=3				// PitchBend Up
PBD=7				// PitchBend Down
Drft=0				// Drift
