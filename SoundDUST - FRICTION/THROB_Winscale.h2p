MidiP=3				// binary data for Midi P param

/*

	ARP Clock

*/

#cm=CLK
Mult=100.00			// Multiply
Base=2				// TimeBase=1/8
Swing=0.00			// Swing
Strict=1				// Strict Host Sync

/*

	Arpeggiator

*/

#cm=ARP
Dir=1				// Direction=up
Oct=2				// Octaves
CDiv=0				// Multiply=1x
Rstrt=0				// Restart=none
OnOff=0				// OnOff
Order=0				// Order=serial

/*

	VoiceCircuit

*/

