/*

	Arpeggiator

*/

#cm=ARP
Dir=5				// Direction=random
Oct=3				// Octaves
CDiv=0				// Multiply=1x
Rstrt=2				// Restart=5
OnOff=1				// OnOff
Order=0				// Order=serial

/*

	VoiceCircuit

*/

