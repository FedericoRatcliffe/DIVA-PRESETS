/*@meta

Author:
'Sound Dust'

Description:
'More West Coast mayhem'

Usage:
'Mod wheel'

Categories:
'FX:Glitch & Weird, FX:Nature & Ambient, FX:Noise & Rumble, Sequences & Arps:Effects'

Features:
'Poly, Sequenced, Host Synced, Percussive'

Character:
'Aggressive, Inharmonic, Defined & Sparse, Distorted'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

	Modulator Reference Table

*/

#nm=24
#ms=none
#ms=ModWhl
#ms=PitchW
#ms=Breath
#ms=Xpress
#ms=Gate
#ms=Velocity
#ms=Pressure
#ms=KeyFollow
#ms=KeyFollow2
#ms=Alternate
#ms=Random
#ms=StackVoice
#ms=VoiceMap
#ms=Env1
#ms=Env2
#ms=LFO1
#ms=LFO2
#ms=Rectify
#ms=Invert
#ms=Quant
#ms=Lag
#ms=Adder
#ms=Multiply
#nv=2
#mv=Gate
#mv=Env1

/*

	Main Loop Circuit

*/

#cm=main
CcOp=100.00			// Output
#FX1=0				// Active #FX1
#FX2=1				// Active #FX2

/*

	Core

*/

#cm=PCore
SBase=4				// SwingBase=1/4
