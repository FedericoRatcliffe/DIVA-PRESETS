Base=2				// TimeBase=1/8
Swing=6.50			// Swing
Strict=1				// Strict Host Sync

/*

	Arpeggiator

*/

#cm=ARP
Dir=3				// Direction=up+dn 1
Oct=4				// Octaves
CDiv=0				// Multiply=1x
Rstrt=5				// Restart=8
OnOff=1				// OnOff
Order=1				// Order=round

/*

	VoiceCircuit

*/

#cm=VCC
