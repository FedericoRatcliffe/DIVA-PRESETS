/*@meta

Author:
'The Unfinished'

Description:
'Soft and drifty, warm pad.'

Categories:
'Pads:Evolving'

Features:
'Poly, Dry, Soft Attack, Slow Release, Sustained, Modulated'

Character:
'Evolving, Rich & Phat, Vintage'

*/

#AM=Diva
#Vers=10001
#Endian=little

/*

